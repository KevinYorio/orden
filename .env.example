# Ejecutar npm.cmd run setup. Credenciales reales fuera de Git.
APP_LOCATION=local
APP_DATA_DIR=
APP_API_TOKEN=
APP_BACKUP_ENCRYPTION_KEY=
APP_PORT=4317
MESSAGING_ADAPTER=simulated
AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=gemma3:latest
LOCAL_EMBEDDING_MODEL=embeddinggemma:latest
RESEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
RESEARCH_MAX_QUERIES_PER_MONTH=100
STORAGE_MODE=local_only
# No completar con nombres de perfil ni números supuestos.
# WhatsApp heredado; no completar con identidades supuestas.
WHATSAPP_GROUP_ID=
WHATSAPP_KEVIN_IDS=
WHATSAPP_LUISINA_IDS=
WHATSAPP_BOT_IDS=
WHATSAPP_ACTIVATED_AT=
# Telegram Bot API oficial, long polling. Configurar IDs numéricos reales fuera de Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_KEVIN_USER_ID=
TELEGRAM_LUISINA_USER_ID=
TELEGRAM_ACTIVATED_AT=
# Sólo modo proxy local: nunca se envía este token al navegador.
REMOTE_APP_URL=
REMOTE_APP_TOKEN=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_DEPLOYMENT_ID=
# Sin muestra verificada y apagado verificable, remoto bloqueado.
RAILWAY_COST_SAMPLE_FILE=
RAILWAY_COST_TOKEN=
RAILWAY_COST_CALIBRATION_FILE=
APP_RECOVERY_ONLY=false
